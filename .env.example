# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Email notifications (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# Rate limiting (optional — Vercel KV or Upstash Redis)
# KV_URL=redis://...

# Admin panel (/admin) — server-only values; use high-entropy values (16+ characters).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Upstash Redis (required: CMS content storage + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (photo uploads from the admin panel) — created via Project → Storage → Blob.
# The long-lived read-write token is required for client-upload token generation.
BLOB_READ_WRITE_TOKEN=
