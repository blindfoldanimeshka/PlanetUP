# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# Rate limiting (optional — Vercel KV or Upstash Redis)
# KV_URL=redis://...

# Admin panel (/admin)
# Client gate password (VITE_*) and server API token must match.
# The admin UI sends VITE_ADMIN_PASSWORD as the x-admin-token header,
# and PUT /api/content checks it against ADMIN_API_TOKEN.
VITE_ADMIN_PASSWORD=changeme
ADMIN_API_TOKEN=changeme
